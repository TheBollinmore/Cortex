dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id in (4688, 4104, 4648, 4697, 7045)
| alter msg = lowercase(action_evtlog_message)
| alter secret_ctx = coalesce(
      arrayindex(regextract(msg, "(password[^\r\n]{0,100})"), 0),
      arrayindex(regextract(msg, "(passwd[^\r\n]{0,100})"), 0),
      arrayindex(regextract(msg, "(pwd[=:][^\r\n]{0,100})"), 0),
      arrayindex(regextract(msg, "(asplaintext[^\r\n]{0,100})"), 0),
      arrayindex(regextract(msg, "(convertto-securestring[^\r\n]{0,100})"), 0),
      arrayindex(regextract(msg, "(/user:\S+\s+\S{4,})"), 0))
| filter secret_ctx != null
| fields _time, agent_hostname, action_evtlog_event_id, actor_effective_username, secret_ctx
| comp count() by secret_ctx 
