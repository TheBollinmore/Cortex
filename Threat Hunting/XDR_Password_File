dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE, ENUM.FILE_RENAME)
| alter fn = lowercase(action_file_name), fp = lowercase(action_file_path)
// cheap prefilter first so the regexes run on a fraction of the rows
| filter fn contains "pass" or fn contains "cred" or fn contains "login" or fn contains "logon" or fn contains "account"
    or fn contains "secret" or fn contains "unattend" or fn contains "sysprep" or fn contains "ntds"
    or fn contains "id_rsa" or fn contains "id_ed25519" or fn contains ".kdbx"
    or fn contains "pgpass"
    or fn contains "htpasswd" or fn contains "tnsnames" or fn contains "groups.xml"
    
| alter category = if(
      fn ~= "pass(word|wd|wort)?s?[^\\]*\.(txt|docx?|xlsx?|csv|rtf|one|md|json|ini|cfg|conf)$", "password_doc",
      fn ~= "cred(ential)?s?[^\\]*\.(txt|docx?|xlsx?|csv|json|xml)$", "cred_doc",
      fn ~= "(login|logon|account)s?[^\\]*\.(txt|docx?|xlsx?|csv)$", "login_doc",
      fn ~= "\.(kdbx|kdb|psafe3|1pif|opvault|agilekeychain)$", "pw_manager_vault",
      fn ~= "^(id_rsa|id_ed25519|id_ecdsa|id_dsa)$" or fn ~= "\.(ppk|pem|pfx|p12|key)$", "private_key",
      fn ~= "^\.?(my\.cnf|mylogin\.cnf|pgpass|netrc|npmrc|pypirc|git-credentials)$", "cli_cred_file",
      fn ~= "^(web\.config|app\.config|appsettings.*\.json|\.env.*|wp-config\.php|settings\.py|database\.yml|secrets\.ya?ml|credentials\.ya?ml|config\.php|\.htpasswd|tnsnames\.ora|sqlnet\.ora)$", "app_config",
      fn ~= "^(unattend\.xml|sysprep\.xml|sysprep\.inf|autounattend\.xml|groups\.xml|services\.xml|scheduledtasks\.xml|datasources\.xml|printers\.xml|drives\.xml)$", "deploy_gpp_xml",
      fn ~= "^(ntds\.dit|sam|system|security)$" or fn ~= "lsass.*\.dmp$" or fn ~= "\.vmem$", "cred_dump",
      fn ~= "\.(rdg|rdp|ovpn|vnc)$", "remote_access_profile",
      null)
| filter category != null
| filter fp not contains "\windows\winsxs\"
    and fp not contains "\windows\servicing\"
    and fp not contains "\program files\"
    and fp not contains "\programdata\microsoft\"
    and fp not contains "\appdata\local\temp\"
    and fp not contains "node_modules"
| comp count() as events, min(_time) as first_seen, max(_time) as last_seen
     by category, agent_hostname, actor_effective_username, actor_process_image_name, action_file_path
| sort desc events
