dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| alter cl = lowercase(action_process_image_command_line)
| alter secret_ctx = coalesce(
      arrayindex(regextract(cl, "(/user:\S+\s+\S{4,})"), 0),
      arrayindex(regextract(cl, "(/password:\S+)"), 0),
      arrayindex(regextract(cl, "(/pass:\S+)"), 0),
      arrayindex(regextract(cl, "(/rp\s+\S+)"), 0),
      arrayindex(regextract(cl, "(/p:\S+)"), 0),
      arrayindex(regextract(cl, "(psexec.*\s-p\s+\S{4,})"), 0),
      arrayindex(regextract(cl, "(sqlcmd.*\s-p\s*\S{4,})"), 0),
      arrayindex(regextract(cl, "(mysql.*\s-p\S{4,})"), 0),
      arrayindex(regextract(cl, "(\s-pw\s+\S+)"), 0),
      arrayindex(regextract(cl, "(curl.*\s-u\s+\S+:\S+)"), 0),
      arrayindex(regextract(cl, "(wget.*--password[= ]\S+)"), 0),
      arrayindex(regextract(cl, "(password[=:]\s*\S{4,})"), 0),
      arrayindex(regextract(cl, "(pwd[=:]\s*\S{4,})"), 0),
      arrayindex(regextract(cl, "(sshpass\s+-p\s+\S+)"), 0),
      arrayindex(regextract(cl, "(net\s+user\s+\S+\s+\S{6,})"), 0),
      arrayindex(regextract(cl, "(convertto-securestring.{0,80})"), 0),
      arrayindex(regextract(cl, "(pscredential.{0,80})"), 0),
      arrayindex(regextract(cl, "(cmdkey.*/pass:\S+)"), 0),
      arrayindex(regextract(cl, "(wmic.*/password:\S+)"), 0))
| filter secret_ctx != null
| filter cl not contains "/user:" or cl ~= "/user:\S+\s+\S{4,}"
| fields _time, agent_hostname, actor_effective_username, action_process_image_name, actor_process_image_name, secret_ctx, action_process_image_command_line
| sort desc _time
