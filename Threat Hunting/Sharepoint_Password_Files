dataset = msft_o365_sharepoint_online_raw
| filter operation in ("FileUploaded", "FileModified", "FileAccessed", "FileDownloaded", "FileSyncUploadedFull", "FileCopied", "FileMoved", "SharingSet", "AnonymousLinkCreated", "SecureLinkCreated", "AddedToSecureLink")
| alter fn = lowercase(sourcefilename)
| filter fn contains "pass" or fn contains "cred" or fn contains "login" or fn contains "account"
    or fn contains ".kdbx" or fn contains ".psafe3" or fn contains ".ppk" or fn contains ".pem" or fn contains ".pfx" or fn contains ".p12"
| alter category = if(
      fn ~= "pass(word|wd)?s?", "password_doc",
      fn ~= "cred(ential)?s?", "cred_doc",
      fn ~= "\.(kdbx|psafe3|ppk|pem|pfx|p12)$", "vault_or_key",
      fn ~= "(login|account)s?\.(xlsx?|docx?|txt)$", "login_doc",
      null)
| filter category != null
| comp count() as ops, count_distinct(userid) as users, count_distinct(clientip) as ips, min(_time) as first_seen, max(_time) as last_seen
     by category, siteurl, sourcerelativeurl, sourcefilename, operation
| sort desc ops
